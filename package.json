{
  "name": "linkedin-scraper",
  "version": "1.0.0",
  "description": "Self-hosted LinkedIn scraper API for profiles, companies, jobs, posts, comments, reactions and search.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "fastify": "^5.10.0",
    "pino": "^10.3.1",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3"
  }
}
